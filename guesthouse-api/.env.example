# =============================================================================
#  Guest House Manager — Backend Environment Variables (.env)
# =============================================================================
#  Local development defaults. Copy to .env and adjust as needed.
# =============================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Configuration (Local or Cloud like Supabase)
# For Supabase Direct Connection, set DB_URL directly (with sslmode=require):
# DB_URL=jdbc:postgresql://db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guesthouse_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# File Upload Storage
FILE_UPLOAD_DIR=./uploads
