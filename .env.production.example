# =============================================================================
#  Guest House Manager — Production Environment (.env.production)
# =============================================================================
#  Copy this file to .env on your AWS EC2 instance before starting Docker Compose:
#  cp .env.production.example .env
# =============================================================================

# Database Secrets
POSTGRES_DB=guesthouse_db
POSTGRES_USER=guesthouse_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!

# Application JWT Secret (Must be 64+ hex chars / strong secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# Redis (cache + JWT revocation) — internal to the Docker network, no host
# port is published. Leave blank unless you've also added --requirepass to
# the redis service's command in docker-compose.yml.
REDIS_PASSWORD=

# Public API Base URL for Frontend
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Optional Domain & SSL Settings (for setup-ssl.sh script)
DOMAIN_NAME=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
